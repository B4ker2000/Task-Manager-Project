<div class="board-wrapper" role="main" [attr.aria-label]="'Project task board for ' + projectTitle">
    <header class="board-header">
        <button class="back-btn" [routerLink]="['/dashboard']" aria-label="Return to the main projects dashboard canvas">← Back to Dashboard</button>
        <h2 id="boardTitleHeader">Project Board ({{ projectTitle }})</h2>
        <div class="board-header-action-triggers" role="navigation" aria-label="Project space configuration controls">
            <button *ngIf="currentUserProjectRole === 'Member'" class="action-btn resign-project-btn" (click)="onLeaveProjectClick()" aria-label="Abandon this project workspace completely">Abandon Space</button>
            
             <button *ngIf="currentUserProjectRole === 'Owner'" class="submit-btn workspace-header-trigger" (click)="isCategoryModalOpen = true" aria-label="Open overlay window to create a new workspace tag">+ Create Workspace Tag</button>
             <button *ngIf="currentUserProjectRole === 'Owner'" class="submit-btn workspace-header-trigger" (click)="openModal()" aria-label="Open overlay window to add a new task item">+ Add New Task</button>
        </div>
    </header>

    <div class="project-member-management-panel" role="region" aria-labelledby="managementPanelHeader">
        <div id="managementPanelHeader" class="invite-header-title">
            <span aria-hidden="true">👥</span> <span>Project Team & Tags Management Workspace</span>
        </div>

        <div class="management-split-row">
            <div class="left-management-column">
                <!-- Active Invitation Submission Row (Visible only to admins/owners) -->
                 <div class="owner-invite-controls" *ngIf="currentUserProjectRole === 'Owner'">
                    <form (ngSubmit)="onInviteUser()" #inviteForm="ngForm" class="invite-action-form" aria-label="Invite new team member to this space">
                        <div class="invite-input-container">
                            <input type="email" 
                                   name="inviteEmail" 
                                   [(ngModel)]="inviteEmail" 
                                   required 
                                   placeholder="Enter teammate's registered email address..." 
                                   class="invite-text-field"
                                   aria-label="Teammate email address entry field"
                                   aria-required="true" />
                        </div>

                        <div class="invite-select-container">
                            <select name="inviteRole" [(ngModel)]="inviteRole" class="invite-dropdown-select" aria-label="Assigned project administrative security level level">
                                <option value="Member">Regular Member</option>
                                <option value="Owner">Co-Owner / Admin</option>
                            </select>
                        </div>

                        <button type="submit" class="submit-btn" [disabled]="!inviteForm.form.valid" aria-label="Submit invitation request to add member">Add Member</button>
                    </form>
                 </div>
        
                <!-- Dynamic roster display list (Visible to everyone) -->
                 <div aria-live="polite" aria-relevant="additions removals" role="region" aria-labelledby="rosterHeader">
                    <h2 id="rosterHeader" class="roster-sub-title">Current Project Crew</h2>
                    <ul class="roster-list-element">
                        <li *ngFor="let m of projectMembers" class="roster-item-row">
                            <div class="member-info-block">
                                <span class="member-display-email">{{ m.userEmail }}</span>
                                <span class="role-display-badge" [ngClass]="{'badge-owner': m.projectRole === 'Owner', 'badge-member': m.projectRole === 'Member'}" [attr.aria-label]="'Assigned Role: ' + m.projectRole">
                                    {{ m.projectRole }}
                                </span>
                            </div>

                            <!--  FIXED: Custom dynamic label targets specific team members by their email context -->
                            <button *ngIf="currentUserProjectRole === 'Owner' && m.userId !== currentUserId" 
                                    class="delete-card-btn" 
                                    (click)="onRemoveMemberClick(m.userId, m.userEmail)" 
                                    title="Remove Member from Project Workspace" 
                                    [attr.aria-label]="'Remove ' + m.userEmail + ' from project crew'">
                                <span aria-hidden="true">🗙</span>
                            </button>
                        </li>
                    </ul>
                 </div>
            </div>

            <!-- DYNAMIC MASTER WORKSPACE TAGS ROSTER -->
             <div class="right-tags-column" role="region" aria-labelledby="tagsHeader">
                <h5 id="tagsHeader"><span aria-hidden="true">🏷️</span> Available Project Tags</h5>

                 <div *ngIf="projectCategories.length === 0" class="tags-roster-tray-fallback" role="status">
                    No custom tags created for this project yet
                 </div>

                 <div class="tags-flex-container" aria-live="polite" aria-relevant="additions removals">
                    <span *ngFor="let cat of projectCategories" class="category-badge-pill" [style.backgroundColor]="cat.colorHex" role="text" [attr.aria-label]="'Tag: ' + cat.name + ' with ' + getTaskCountByCategory(cat.id) + ' assigned items'">
                        <span>{{ cat.name }} ({{ getTaskCountByCategory(cat.id) }})</span>

                         <button *ngIf="currentUserProjectRole === 'Owner'" 
                                 (click)="onDeleteCategoryClick(cat.id, cat.name)" 
                                 title="Permanently Delete Workspace Tag" 
                                 class="category-badge-pill-delete-btn" 
                                 [attr.aria-label]="'Permanently delete project tag: ' + cat.name">
                            <span aria-hidden="true">✕</span>
                         </button>
                    </span>
                 </div>
             </div>
        </div>
    </div>

    <div class="board-controls-panel" role="search" aria-label="Task board item filtering hub">
        <div class="search-filter-group">

            <!-- Task Text Search -->
             <div class="control-input-wrapper">
                <span class="control-icon-anchor" aria-hidden="true">🔍</span>
                <input type="text" [(ngModel)]="searchQuery" (ngModelChange)="applyFilters()" placeholder="Search tasks by title..." class="board-interactive-field search" aria-label="Filter tasks by text title keyword" />
             </div>

            <!-- Search by Selecting Priority -->
             <div class="control-input-wrapper">
                <span class="control-icon-anchor" aria-hidden="true">🎯</span>
                <select [(ngModel)]="selectedPriority" (ngModelChange)="applyFilters()" class="board-interactive-field priority" aria-label="Filter tasks by designated priority level">
                    <option value="All">All Priorities</option>
                    <option value="High">High Priority</option>
                    <option value="Medium">Medium Priority</option>
                    <option value="Low">Low Priority</option>
                </select>
             </div>

            <!-- Search by Selecting Category Tag -->
             <div class="control-input-wrapper">
                <span class="control-icon-anchor" aria-hidden="true">🏷️</span>
                <select id="searchCategory" [(ngModel)]="selectedCategory" (change)="applyFilters()" class="board-interactive-field category" aria-label="Filter tasks by active project category tag assignment">
                    <option value="All">All Tags</option>
                    <option value="Null">Unassigned Tasks</option>
                    <option *ngFor="let cat of projectCategories" [value]="cat.id">
                        {{ cat.name }}
                    </option>
                </select>
             </div>
        </div>

        <!-- Live Project Progress Analytics Tracker -->
         <!-- 📊 Progress Bar: Transformed into a compliant ARIA widget tracking completion parameters -->
         <div class="progress-analytics" 
              role="progressbar" 
              [attr.aria-valuenow]="completionPercentage" 
              aria-valuemin="0" 
              aria-valuemax="100" 
              [attr.aria-label]="'Overall project completion progress tracker. Currently at ' + completionPercentage + ' percent.'">
            <div class="priority-text-label">
                <span>Project Completion Progress:</span>
                <strong>{{ completionPercentage }}%</strong>
            </div>
            <div class="progress-bar-track" aria-hidden="true">
                <div class="progress-bar-fill" [style.width.%]="completionPercentage"></div>
            </div>
         </div>
    </div>

    <!-- Mobile/Vertical screen, column navigation buttons -->
    <div class="mobile-board-lane-switcher" role="tablist" aria-label="Mobile task board column views">
        <button class="lane-tab-trigger" 
                role="tab"
                [attr.aria-selected]="activeMobileColumn === 'Pending'"
                [ngClass]="{'active': activeMobileColumn === 'Pending'}" 
                (click)="activeMobileColumn = 'Pending'"
                aria-label="View Pending tasks column">
            <span aria-hidden="true">⏳</span> Pending
        </button>
        <button class="lane-tab-trigger" 
                role="tab"
                [attr.aria-selected]="activeMobileColumn === 'InProgress'"
                [ngClass]="{'active': activeMobileColumn === 'InProgress'}" 
                (click)="activeMobileColumn = 'InProgress'"
                aria-label="View Tasks In Progress and Review column">
            <span aria-hidden="true">⚡</span> Progress & Review
        </button>
        <button class="lane-tab-trigger" 
                role="tab"
                [attr.aria-selected]="activeMobileColumn === 'Completed'"
                [ngClass]="{'active': activeMobileColumn === 'Completed'}" 
                (click)="activeMobileColumn = 'Completed'"
                aria-label="View Completed tasks column">
            <span aria-hidden="true">✅</span> Completed
        </button>
    </div>

    <div class="board-columns-grid" cdkDropListGroup>
        <!-- Column 1: Pending Tasks -->
		 <section class="board-column" 
                  [class.mobile-hidden]="activeMobileColumn !== 'Pending'"
                  role="region"
                  aria-labelledby="pendingColumnHeader">
			<h3 id="pendingColumnHeader">
                <span aria-hidden="true">⏳</span> Pending ({{ pendingTasks.length }})
            </h3>

            <!-- CDK Target Drop Window Container Lane -->
             <div id="pendingLaneList"
                 cdkDropList
                 [cdkDropListData]="pendingTasks"
                 (cdkDropListDropped)="onTaskCardDropTrigger($event)" 
                 class="tasks-container"
                 aria-live="polite"
                 aria-relevant="additions removals"
                 [attr.aria-label]="'Pending task tracking list lane. Contains ' + pendingTasks.length + ' items.'">

                <!-- Draggable Task Card Template Block -->
                 <div class="task-card" 
                     *ngFor="let t of filteredPendingTasks"
                     cdkDrag
                     role="article"
                     [attr.id]="'task-card-' + t.id"
                     [attr.aria-label]="'Task item card: ' + t.title">

                    <div class="task-card-header">
                        <h4 [attr.id]="'task-title-' + t.id">{{ t.title }}</h4>
                        <!-- DYNAMIC CATEGORY DISPLAY BADGE -->
                         <span *ngIf="t.category" class="task-category-tag-wrapper">
                             <span class="category-badge-pill" [style.backgroundColor]="t.category.colorHex" [attr.aria-label]="'Assigned Category Tag: ' + t.category.name">
                                <span aria-hidden="true">🏷️</span> {{ t.category.name }}
                             </span>
                         </span>
                        <button *ngIf="currentUserProjectRole === 'Owner'" 
                                class="delete-card-btn" 
                                (click)="onDeleteTask(t.id)" 
                                [attr.aria-label]="'Delete task card: ' + t.title"
                                [attr.aria-describedby]="'task-title-' + t.id">
                            <span aria-hidden="true">🗑️</span>
                        </button>
                    </div>

                    <p>{{ t.description || 'No details provided.' }}</p>

                    <div class="task-assignment-control">
                        <label [attr.for]="'assignee-select-' + t.id" class="assignment-label">
                            <span aria-hidden="true">👤</span> Assignee:
                        </label>
                        <select [id]="'assignee-select-' + t.id"
                                [ngModel]="t.assignedUserId" 
                                (change)="onAssignUser(t.id, $any($event.target).value)" 
                                class="assignee-dropdown-menu" 
                                [disabled]="currentUserProjectRole !== 'Owner'"
                                [attr.aria-label]="'Assign staff member to task ' + t.title">
                            <option [value]="null">Unassigned</option>
                            <option *ngFor="let m of projectMembers" [value]="m.userId">
                                {{ m.userName }} ({{ m.userEmail }})
                            </option>
                        </select>
                    </div>

                    <div *ngIf="currentUserProjectRole === 'Owner' || t.assignedUserId === currentUserId" class="task-assignment-control">
                        <label [attr.for]="'category-select-' + t.id" class="assignment-label">
                            <span aria-hidden="true">🏷️</span> Category:
                        </label>
                        <select [id]="'category-select-' + t.id"
                                [ngModel]="t.categoryId" 
                                (change)="onAssignCategory(t.id, $any($event.target).value)" 
                                [disabled]="currentUserProjectRole !== 'Owner' && t.assignedUserId !== currentUserId" 
                                class="assignee-dropdown-menu"
                                [attr.aria-label]="'Assign classification tag to task ' + t.title">
                            <option [value]="null">No Category</option>
                            <option *ngFor="let cat of projectCategories" [value]="cat.id">
                                {{ cat.name }}
                            </option>
                        </select>
                    </div>

                    <div class="task-actions">
                        <div class="badge-group">
                            <span class="priority-badge" [ngClass]="t.priority.toLowerCase()" [attr.aria-label]="'Priority level: ' + t.priority">
                                <span *ngIf="t.priority === 'High'"><span aria-hidden="true">🔴 🔺</span> High</span>
                                <span *ngIf="t.priority === 'Medium'"><span aria-hidden="true">🟡 🔸</span> Medium</span>
                                <span *ngIf="t.priority === 'Low'"><span aria-hidden="true">🔵 🔹</span> Low</span>
                            </span>
                            <span class="deadline-badge" *ngIf="t.deadline" [attr.aria-label]="'Task deadline calendar date: ' + (t.deadline | date:'yyyy/MM/dd')">
                                <span aria-hidden="true">📅</span> {{ t.deadline | date:"yyyy/MM/dd" }}
                            </span>
                        </div>
                        <button *ngIf="currentUserProjectRole === 'Owner' || t.assignedUserId === currentUserId" 
                                class="action-btn next" 
                                (click)="onUpdateStatus(t.id, 'In Progress')"
                                [attr.aria-label]="'Start work item: ' + t.title + '. Moves card to In Progress column.'">
                            
                            Start →
                        </button>
                    </div>
                 </div>
             </div>
         </section>

		<!-- Column 2: In Progress & Review Tasks -->
